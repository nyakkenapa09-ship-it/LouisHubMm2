-- // HELPER FUNCTIONS //
local function IsMurderer(player)
    local char = player.Character
    local bp = player:FindFirstChild("Backpack")
    return (char and char:FindFirstChild("Knife")) or (bp and bp:FindFirstChild("Knife"))
end

local function IsArmed(player)
    local char = player.Character
    local bp = player:FindFirstChild("Backpack")
    return (char and char:FindFirstChild("Gun")) or (bp and bp:FindFirstChild("Gun"))
end

local function GetRoleColor(player)
    if IsMurderer(player) then return Color3.fromRGB(255, 0, 0) end -- Merah (Murderer)
    if IsArmed(player) then
        if player:FindFirstChild("RoleStat") and player.RoleStat.Value == "Sheriff" then
            return Color3.fromRGB(0, 0, 255) -- Biru (Sheriff Asli)
        else
            return Color3.fromRGB(255, 255, 0) -- Kuning (Hero)
        end
    end
    return Color3.fromRGB(0, 255, 0) -- Hijau (Innocent)
end

local function CreateHighlight(target, color)
    if not ESP_Cache[target] then
        local hl = Instance.new("Highlight")
        hl.Adornee = target -- Bypass Limit
        hl.Parent = CoreGui -- Sembunyikan di CoreGui agar anti-error
        hl.FillOpacity = 0.5
        hl.OutlineOpacity = 1
        hl.FillColor = color
        hl.OutlineColor = color
        ESP_Cache[target] = hl
    else
        ESP_Cache[target].FillColor = color
        ESP_Cache[target].OutlineColor = color
    end
end

