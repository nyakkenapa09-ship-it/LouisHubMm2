local function getRoleColor(player)
    local char = player.Character
    local bp = player:FindFirstChild("Backpack")
    
    if (bp and bp:FindFirstChild("Knife")) or (char and char:FindFirstChild("Knife")) then
        return Color3.fromRGB(255, 0, 0) -- Merah (Murder)
    elseif (bp and bp:FindFirstChild("Gun")) or (char and char:FindFirstChild("Gun")) then
        if player:FindFirstChild("RoleStat") and player.RoleStat.Value == "Sheriff" then
            return Color3.fromRGB(0, 0, 255) -- Biru (Sheriff Asli)
        else
            return Color3.fromRGB(255, 255, 0) -- Kuning (Hero)
        end
    end
    return Color3.fromRGB(0, 255, 0) -- Hijau (Innocent)
end

RunService.RenderStepped:Connect(function()
    -- ESP Player
    for _, p in pairs(Players:GetPlayers()) do
        if p ~= LocalPlayer and p.Character then
            local hl = p.Character:FindFirstChild("L_ESP")
            if ESP_Enabled then
                if not hl then
                    hl = Instance.new("Highlight")
                    hl.Name = "L_ESP"
                    hl.Parent = p.Character
                    hl.FillOpacity = 0.5
                    hl.OutlineOpacity = 0
                end
                hl.FillColor = getRoleColor(p)
                hl.OutlineColor = getRoleColor(p)
            else
                if hl then hl:Destroy() end
            end
        end
    end

    -- ESP Gun Drop
    for _, obj in pairs(workspace:GetChildren()) do
        if obj.Name == "GunDrop" then
            local hl = obj:FindFirstChild("L_GunESP")
            if ESP_Enabled then
                if not hl then
                    hl = Instance.new("Highlight")
                    hl.Name = "L_GunESP"
                    hl.Parent = obj
                    hl.FillColor = Color3.fromRGB(0, 0, 255)
                    hl.OutlineColor = Color3.fromRGB(0, 0, 255)
                    hl.FillOpacity = 0.5
                    hl.OutlineOpacity = 0
                end
            else
                if hl then hl:Destroy() end
            end
        end
    end
end)

