local Workspace = game:GetService("Workspace")
local Players = game:GetService("Players")
local LocalPlayer = Players.LocalPlayer

_G.SilentAim = true
_G.TeamCheck = true

-- GUN DROP TRACKER (Biru Tua)
local function highlightGun(object)
    if (object.Name == "GunDrop" or object.Name == "Normal") and not object:FindFirstChild("GunESP") then
        if object:IsA("Model") or object:IsA("BasePart") then
            local highlight = Instance.new("Highlight")
            highlight.Name = "GunESP"
            highlight.FillColor = Color3.fromRGB(0, 0, 139)
            highlight.OutlineColor = Color3.fromRGB(255, 255, 255)
            highlight.FillTransparency = 0.3
            highlight.Parent = object
        end
    end
end

Workspace.DescendantAdded:Connect(highlightGun)
for _, obj in pairs(Workspace:GetDescendants()) do highlightGun(obj) end

-- SILENT AIM TARGETING
local function getClosestPlayer()
    local closestPlayer = nil
    local shortestDistance = math.huge
    for _, player in pairs(Players:GetPlayers()) do
        if player ~= LocalPlayer and player.Character and player.Character:FindFirstChild("HumanoidRootPart") and player.Character:FindFirstChildOfClass("Humanoid").Health > 0 then
            local isMurderer = player.Backpack:FindFirstChild("Knife") or player.Character:FindFirstChild("Knife")
            local isSheriff = player.Backpack:FindFirstChild("Gun") or player.Character:FindFirstChild("Gun")
            local currentTool = LocalPlayer.Character:FindFirstChildOfClass("Tool")
            local amSheriff = currentTool and currentTool.Name == "Gun"
            local isValidTarget = false
            
            if amSheriff then
                if isMurderer then isValidTarget = true end
            else
                if _G.TeamCheck and isSheriff then isValidTarget = true
                elseif not _G.TeamCheck or not isSheriff then isValidTarget = true end
            end

            if isValidTarget then
                local distance = (LocalPlayer.Character.HumanoidRootPart.Position - player.Character.HumanoidRootPart.Position).Magnitude
                if distance < shortestDistance then
                    closestPlayer = player
                    shortestDistance = distance
                end
            end
        end
    end
    return closestPlayer
end

-- METATABLE HOOKING FOR SILENT AIM
local mt = getrawmetatable(game)
local oldNamecall = mt.__namecall
local oldIndex = mt.__index
setreadonly(mt, false)

mt.__namecall = newcclosure(function(self, ...)
    local method = getnamecallmethod()
    local args = {...}
    if _G.SilentAim and (method == "FindPartOnRayWithIgnoreList" or method == "FindPartOnRay" or method == "Raycast") then
        local target = getClosestPlayer()
        if target and target.Character and target.Character:FindFirstChild("HumanoidRootPart") then
            if args[1] then
                local origin = args[1].Origin
                args[1] = Ray.new(origin, (target.Character.HumanoidRootPart.Position - origin).Unit * 1000)
                return oldNamecall(self, unpack(args))
            end
        end
    end
    return oldNamecall(self, ...)
end)

mt.__index = newcclosure(function(self, index)
    if _G.SilentAim and tostring(self) == "Mouse" and index == "Hit" then
        local target = getClosestPlayer()
        if target and target.Character and target.Character:FindFirstChild("HumanoidRootPart") then
            return target.Character.HumanoidRootPart.CFrame
        end
    end
    return oldIndex(self, index)
end)

setreadonly(mt, true)
