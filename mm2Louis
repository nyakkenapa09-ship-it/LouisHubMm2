-- Variables & Cache untuk hemat memori
local Players = game:GetService("Players")
local LocalPlayer = Players.LocalPlayer
local Mouse = LocalPlayer:GetMouse()
local SilentAimEnabled = false

local lastCheck = 0
local cachedMurderer = nil

-- Fungsi Nyari Murderer dengan Throttling (Gak ngecek tiap frame biar ga lag)
local function GetMurderer()
    local currentTime = os.clock()
    -- Cek ulang setiap 0.5 detik sekali, bukan setiap milidetik
    if currentTime - lastCheck < 0.5 and cachedMurderer and cachedMurderer.Parent then
        return cachedMurderer
    end
    
    lastCheck = currentTime
    cachedMurderer = nil
    
    for _, player in pairs(Players:GetPlayers()) do
        if player ~= LocalPlayer and player.Character and player.Character:FindFirstChild("HumanoidRootPart") then
            if player.Character:FindFirstChild("Knife") or player.Backpack:FindFirstChild("Knife") then
                cachedMurderer = player.Character
                return cachedMurderer
            end
        end
    end
    return nil
end

-- __index Hook Ringan (Hanya memanipulasi Input Mouse saat menembak)
local OldIndex
OldIndex = hookmetamethod(game, "__index", function(Self, Property)
    -- Validasi cepat: abaikan jika fitur mati atau bukan objek Mouse
    if not SilentAimEnabled or Self ~= Mouse then 
        return OldIndex(Self, Property) 
    end
    
    if Property == "Hit" or Property == "Target" then
        -- Cek instan apakah player megang senjata
        local Char = LocalPlayer.Character
        if Char and (Char:FindFirstChild("Gun") or LocalPlayer.Backpack:FindFirstChild("Gun")) then
            local Murderer = GetMurderer()
            if Murderer and Murderer:FindFirstChild("HumanoidRootPart") then
                if Property == "Hit" then
                    return Murderer.HumanoidRootPart.CFrame
                elseif Property == "Target" then
                    return Murderer.HumanoidRootPart
                end
            end
        end
    end
    
    return OldIndex(Self, Property)
end)

