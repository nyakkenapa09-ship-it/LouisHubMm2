-- MM2 Gun Drop ESP - Anti Lag Version
local Workspace = game:GetService("Workspace")

local function applyGunESP(object)
    -- MM2 mendeteksi 'GunDrop' sebagai nama folder atau model pistol yang jatuh
    if object.Name == "GunDrop" or object:FindFirstChild("KnifeServer") == nil and object:FindFirstChild("GunServer") then
        -- Cek biar gak double pasang highlight
        if not object:FindFirstChild("GunDropHighlight") then
            local highlight = Instance.new("Highlight")
            highlight.Name = "GunDropHighlight"
            
            -- Warna isi Biru Tua (Dark Blue)
            highlight.FillColor = Color3.fromRGB(0, 0, 139) 
            -- Garis luar Putih terang biar kontras menembus tembok
            highlight.OutlineColor = Color3.fromRGB(255, 255, 255) 
            
            highlight.FillTransparency = 0.4
            highlight.OutlineTransparency = 0
            highlight.Parent = object
        end
    end
end

-- 1. Scan objek yang UDAH ADA di map pas script di-execute
for _, v in pairs(Workspace:GetDescendants()) do
    pcall(applyGunESP, v)
end

-- 2. Scan otomatis pake Event (Hanya jalan pas ada objek baru, jadi GA LAG sama sekali!)
Workspace.DescendantAdded:Connect(function(descendant)
    pcall(applyGunESP, descendant)
end)
