-- ANIMASI LOADING (Mengisi Bar & Ganti Teks Status)
local function runLoader()
    local stages = {
        {time = 1.0, text = "Bypassing Anticheat...", progress = 0.25},
        {time = 1.2, text = "Injecting Silent Aim Metatable...", progress = 0.60},
        {time = 0.8, text = "Activating Blue Gun Tracker...", progress = 0.85},
        {time = 0.5, text = "Done! Enjoy Bantai Server!", progress = 1.0}
    }
    
    for _, stage in ipairs(stages) do
        Status.Text = stage.text
        BarProgress:TweenSize(UDim2.new(stage.progress, 0, 1, 0), "Out", "Quad", stage.time, true)
        task.wait(stage.time)
    end
    
    -- Hapus Loader GUI setelah selesai loading
    ScreenGui:Destroy()
end

-- Jalankan Loader di Background Thread
task.spawn(runLoader)
task.wait(3.5) -- Nunggu animasi loading kelar sebelum script inti jalan

