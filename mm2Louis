-- // LOGIC SILENT AIM (100% ACCURACY) //
-- ========================================== --

local oldNamecall
oldNamecall = hookmetamethod(game, "__namecall", function(self, ...)
    local method = getnamecallmethod()
    local args = {...}
    
    if not checkcaller() and method == "FireServer" then
        
        -- Silent Aim Sheriff -> Target Murderer
        if self.Name == "ShootGun" and SilentSheriff then
            for _, v in pairs(Players:GetPlayers()) do
                if v ~= LocalPlayer and v.Character and v.Character:FindFirstChild("HumanoidRootPart") then
                    local hum = v.Character:FindFirstChild("Humanoid")
                    local isTargetMurder = (v.Character:FindFirstChild("Knife") or (v.Backpack and v.Backpack:FindFirstChild("Knife")))
                    
                    if hum and hum.Health > 0 and isTargetMurder then
                        for i, arg in pairs(args) do
                            if typeof(arg) == "Vector3" then
                                args[i] = v.Character.HumanoidRootPart.Position
                                return oldNamecall(self, unpack(args))
                            end
                        end
                    end
                end
            end
            
        -- Silent Aim Murderer -> Target Selain Murderer
        elseif self.Name == "ThrowKnife" and SilentMurder then
            for _, v in pairs(Players:GetPlayers()) do
                if v ~= LocalPlayer and v.Character and v.Character:FindFirstChild("HumanoidRootPart") then
                    local hum = v.Character:FindFirstChild("Humanoid")
                    local isOtherMurder = (v.Character:FindFirstChild("Knife") or (v.Backpack and v.Backpack:FindFirstChild("Knife")))
                    
                    if hum and hum.Health > 0 and not isOtherMurder then 
                        for i, arg in pairs(args) do
                            if typeof(arg) == "Vector3" then
                                args[i] = v.Character.HumanoidRootPart.Position
                                return oldNamecall(self, unpack(args))
                            end
                        end
                    end
                end
            end
        end
        
    end
    return oldNamecall(self, ...)
end)

