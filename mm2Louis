-- // LOGIC SILENT AIM (FIXED UNTUK EXECUTOR HP) //
-- ========================================== --

local mt = getrawmetatable(game)
local oldNamecall = mt.__namecall
setreadonly(mt, false)

mt.__namecall = newcclosure(function(self, ...)
    local method = getnamecallmethod()
    local args = {...}

    if not checkcaller() then
        -- SHERIFF SILENT AIM (Tembakan pakai InvokeServer)
        if (method == "InvokeServer" or method == "FireServer") and self.Name == "ShootGun" and SilentSheriff then
            for _, v in pairs(Players:GetPlayers()) do
                if v ~= LocalPlayer and v.Character and v.Character:FindFirstChild("HumanoidRootPart") then
                    local isMurder = v.Character:FindFirstChild("Knife") or (v.Backpack and v.Backpack:FindFirstChild("Knife"))
                    if isMurder then
                        args[2] = v.Character.HumanoidRootPart.Position
                        return oldNamecall(self, unpack(args))
                    end
                end
            end
        end

        -- MURDERER SILENT AIM (Lemparan pakai FireServer)
        if (method == "InvokeServer" or method == "FireServer") and self.Name == "ThrowKnife" and SilentMurder then
            for _, v in pairs(Players:GetPlayers()) do
                if v ~= LocalPlayer and v.Character and v.Character:FindFirstChild("HumanoidRootPart") then
                    local isOtherMurder = v.Character:FindFirstChild("Knife") or (v.Backpack and v.Backpack:FindFirstChild("Knife"))
                    if not isOtherMurder then
                        args[2] = v.Character.HumanoidRootPart.Position
                        return oldNamecall(self, unpack(args))
                    end
                end
            end
        end
    end

    return oldNamecall(self, ...)
end)
setreadonly(mt, true)

