                        ESP_Cache[p.Character] = nil
                    end
                end
            end
        end
        
        -- 2. Gun Drop ESP (Biru)
        for _, obj in pairs(workspace:GetChildren()) do
            if obj.Name == "GunDrop" then
                CreateHighlight(obj, Color3.fromRGB(0, 0, 255)) -- Biru
            end
        end
    end
    
    -- Auto-Cleanup (Bersihkan sampah highlight jika objek hilang)
    for target, hl in pairs(ESP_Cache) do
        if not target or not target.Parent then
            hl:Destroy()
            ESP_Cache[target] = nil
        end
    end
end)

-- // LOGIC SILENT AIM (100% ACCURACY VIA VECTOR3 REPLACEMENT) //
local oldNamecall
oldNamecall = hookmetamethod(game, "__namecall", function(self, ...)
    local method = getnamecallmethod()
    local args = {...}
    
    if not checkcaller() and method == "FireServer" then
        
        -- A. Silent Aim Sheriff -> Target Murderer
        if self.Name == "ShootGun" and SilentSheriff then
            for _, v in pairs(Players:GetPlayers()) do
                if v ~= LocalPlayer and v.Character and v.Character:FindFirstChild("HumanoidRootPart") then
                    local hum = v.Character:FindFirstChild("Humanoid")
                    if hum and hum.Health > 0 and IsMurderer(v) then
                        for i, arg in pairs(args) do
                            if typeof(arg) == "Vector3" then
                                args[i] = v.Character.HumanoidRootPart.Position
                                return oldNamecall(self, unpack(args))
                            end
                        end
                    end
                end
            end
            
        -- B. Silent Aim Murderer -> Target Selain Murderer (Sheriff/Hero/Innocent)
        elseif self.Name == "ThrowKnife" and SilentMurder then
            for _, v in pairs(Players:GetPlayers()) do
                if v ~= LocalPlayer and v.Character and v.Character:FindFirstChild("HumanoidRootPart") then
                    local hum = v.Character:FindFirstChild("Humanoid")
                    if hum and hum.Health > 0 and not IsMurderer(v) then 
                        for i, arg in pairs(args) do
                            if typeof(arg) == "Vector3" then
                                args[i] = v.Character.HumanoidRootPart.Position
                                return oldNamecall(self, unpack(args))
                            end
                        end
                    end
                end
            end
        end
        
    end
    return oldNamecall(self, ...)
end)

