-- Memuat Library Rayfield
local Rayfield = loadstring(game:HttpGet('https://sirius.menu/rayfield'))()

local Window = Rayfield:CreateWindow({
   Name = "Aurora Lite | MM2 Private Lab",
   LoadingTitle = "Aurora Lite Initializing...",
   LoadingSubtitle = "by Sky",
   ConfigurationSaving = { Enabled = false }
})

local Tab = Window:CreateTab("Sheriff Tools", nil) -- Tab untuk Sheriff

-- Variabel status global
local AutoGrabStatus = false

-- Fungsi inti Grab Gun dengan proteksi nil-checking
local function grabGun()
    local LocalPlayer = game.Players.LocalPlayer
    local Workspace = game:GetService("Workspace")
    
    -- Pastikan karakter pemain dan HumanoidRootPart tersedia sebelum cek jarak
    if not LocalPlayer.Character or not LocalPlayer.Character:FindFirstChild("HumanoidRootPart") then 
        return 
    end
    
    local hrp = LocalPlayer.Character.HumanoidRootPart
    
    for _, item in ipairs(Workspace:GetDescendants()) do
        if item.Name == "Gun" and item:IsA("Tool") and item:FindFirstChild("Handle") then
            local dist = (hrp.Position - item.Handle.Position).Magnitude
            if dist < 100 then -- Radius deteksi (studs)
                -- Proteksi eksistensi fungsi executor
                if firetouchinterest then
                    firetouchinterest(hrp, item.Handle, 0)
                    task.wait(0.05) -- Delay super tipis agar registrasi touch stabil
                    firetouchinterest(hrp, item.Handle, 1)
                end
            end
        end
    end
end

-- Menambahkan Toggle ke UI Rayfield
Tab:CreateToggle({
   Name = "Auto Grab Gun",
   CurrentValue = false,
   Flag = "GrabGunToggle",
   Callback = function(Value)
      AutoGrabStatus = Value
      
      if AutoGrabStatus then
         print("Aurora: Auto Grab Gun Enabled.")
         
         -- FIX: Jalankan loop di thread terpisah (task.spawn) agar UI tidak freeze
         task.spawn(function()
            while AutoGrabStatus do
               -- Menggunakan pcall agar jika pistol tiba-tiba hilang/destroyed saat dicek, script tidak eror
               pcall(grabGun)
               task.wait(0.5) -- Interval pengecekan ulang
            end
         end)
      else
         print("Aurora: Auto Grab Gun Disabled.")
      end
   end
})

Rayfield:LoadConfiguration()
print("Aurora Lite: UI Loaded and Ready.")
