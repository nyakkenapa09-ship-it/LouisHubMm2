-- // ESP LOGIC // --
local function GetColor(p)
    local char = p.Character
    local bp = p:FindFirstChild("Backpack")
    if char and (char:FindFirstChild("Knife") or (bp and bp:FindFirstChild("Knife"))) then return Color3.fromRGB(255, 0, 0) end -- Murder
    if char and (char:FindFirstChild("Gun") or (bp and bp:FindFirstChild("Gun"))) then
        if p:FindFirstChild("RoleStat") and p.RoleStat.Value == "Sheriff" then return Color3.fromRGB(0, 0, 255) end -- Sheriff
        return Color3.fromRGB(255, 255, 0) -- Hero
    end
    return Color3.fromRGB(0, 255, 0) -- Innocent
end

RunService.RenderStepped:Connect(function()
    -- Update Stats
    FPSLabel.Text = "FPS: " .. math.floor(workspace:GetRealPhysicsFPS())
    PingLabel.Text = "Ping: " .. math.floor(game:GetService("Stats").Network.ServerStatsItem["Data Ping"]:GetValue()) .. "ms"

    -- Player ESP
    for _, p in pairs(Players:GetPlayers()) do
        if p ~= LocalPlayer and p.Character then
            local hl = p.Character:FindFirstChild("LHubHL")
            if ESP_Enabled then
                if not hl then
                    hl = Instance.new("Highlight", p.Character)
                    hl.Name = "LHubHL"
                end
                hl.OutlineColor = GetColor(p)
                hl.FillColor = GetColor(p)
                hl.FillOpacity = 0.5
            elseif hl then hl:Destroy() end
        end
    end
    
    -- Gun Drop ESP (Blue)
    for _, obj in pairs(workspace:GetChildren()) do
        if obj.Name == "GunDrop" then
            local hl = obj:FindFirstChild("LHubGun")
            if GunESP_Enabled then
                if not hl then
                    hl = Instance.new("Highlight", obj)
                    hl.Name = "LHubGun"
                    hl.FillColor = Color3.fromRGB(0, 0, 255)
                    hl.OutlineColor = Color3.fromRGB(0, 0, 255)
                end
            elseif hl then hl:Destroy() end
        end
    end
end)

-- // SILENT AIM LOGIC // --
local old; old = hookmetamethod(game, "__namecall", function(self, ...)
    local method = getnamecallmethod()
    local args = {...}
    if not checkcaller() and method == "FireServer" then
        if self.Name == "ShootGun" and SilentSheriff then
            for _, v in pairs(Players:GetPlayers()) do
                if v.Character and (v.Character:FindFirstChild("Knife") or (v.Backpack and v.Backpack:FindFirstChild("Knife"))) then
                    args[2] = v.Character.HumanoidRootPart.Position
                    return old(self, unpack(args))
                end
            end
        elseif self.Name == "ThrowKnife" and SilentMurder then
            for _, v in pairs(Players:GetPlayers()) do
                if v ~= LocalPlayer and v.Character and v.Character:FindFirstChild("HumanoidRootPart") then
                    local isTarget = not (v.Character:FindFirstChild("Knife") or (v.Backpack and v.Backpack:FindFirstChild("Knife")))
                    if isTarget then
                        args[2] = v.Character.HumanoidRootPart.Position
                        return old(self, unpack(args))
                    end
                end
            end
        end
    end
    return old(self, ...)
end)

