-- // LOGIC ESP LOOP
RunService.RenderStepped:Connect(function()
    -- Player ESP
    if ESP_Enabled then
        for _, player in pairs(Players:GetPlayers()) do
            if player ~= LocalPlayer and player.Character then
                local highlight = player.Character:FindFirstChild("LouisHub_ESP")
                if not highlight then
                    highlight = Instance.new("Highlight")
                    highlight.Name = "LouisHub_ESP"
                    highlight.Parent = player.Character
                    highlight.FillOpacity = 0.5
                    highlight.OutlineOpacity = 0
                end
                highlight.OutlineColor = getRoleColor(player)
                highlight.FillColor = getRoleColor(player)
            end
        end
    end

    -- Gun Drop ESP (Biru)
    if GunESP_Enabled then
        for _, obj in pairs(workspace:GetChildren()) do
            if obj.Name == "GunDrop" then
                local highlight = obj:FindFirstChild("LouisHub_GunESP")
                if not highlight then
                    highlight = Instance.new("Highlight")
                    highlight.Name = "LouisHub_GunESP"
                    highlight.Parent = obj
                    highlight.FillColor = Color3.fromRGB(0, 0, 255) -- Biru
                    highlight.OutlineColor = Color3.fromRGB(0, 0, 255)
                end
            end
        end
    end
end)

-- // LOGIC SILENT AIM (Metatable Hook)
local oldNamecall
oldNamecall = hookmetamethod(game, "__namecall", function(self, ...)
    local method = getnamecallmethod()
    local args = {...}

    if not checkcaller() and method == "FireServer" and self.Name == "ShootGun" and SilentAim_Enabled then
        for _, v in pairs(Players:GetPlayers()) do
            if v ~= LocalPlayer and v.Character and v.Character:FindFirstChild("HumanoidRootPart") then
                -- Hanya target Murderer (yang bawa Knife)
                if v.Character:FindFirstChild("Knife") or (v.Backpack and v.Backpack:FindFirstChild("Knife")) then
                    args[2] = v.Character.HumanoidRootPart.Position
                    return oldNamecall(self, unpack(args))
                end
            end
        end
    end
    return oldNamecall(self, ...)
end)

