-- // HELPER FUNCTIONS //
local function IsMurderer(player)
    local char = player.Character
    local bp = player:FindFirstChild("Backpack")
    return (char and char:FindFirstChild("Knife")) or (bp and bp:FindFirstChild("Knife"))
end

local function IsSheriffOrHero(player)
    local char = player.Character
    local bp = player:FindFirstChild("Backpack")
    return (char and char:FindFirstChild("Gun")) or (bp and bp:FindFirstChild("Gun"))
end

local function GetRoleColor(player)
    if IsMurderer(player) then
        return Color3.fromRGB(255, 0, 0) -- Red
    elseif IsSheriffOrHero(player) then
        if player:FindFirstChild("RoleStat") and player.RoleStat.Value == "Sheriff" then
            return Color3.fromRGB(0, 0, 255) -- Blue
        end
        return Color3.fromRGB(255, 255, 0) -- Yellow
    end
    return Color3.fromRGB(0, 255, 0) -- Green
end

-- // LOGIC ESP LOOP //
RunService.RenderStepped:Connect(function()
    -- Player ESP
    if ESP_Enabled then
        for _, p in pairs(Players:GetPlayers()) do
            if p ~= LocalPlayer and p.Character and p.Character:FindFirstChild("HumanoidRootPart") then
                local hl = p.Character:FindFirstChild("LouisHL")
                if not hl then
                    hl = Instance.new("Highlight")
                    hl.Name = "LouisHL"
                    hl.Parent = p.Character
                end
                hl.OutlineColor = GetRoleColor(p)
                hl.FillColor = GetRoleColor(p)
                hl.FillOpacity = 0.5
                hl.OutlineOpacity = 1 -- Outline lebih jelas
            end
        end
    end
    
    -- Gun Drop ESP (Blue)
    if GunESP_Enabled then
        for _, obj in pairs(workspace:GetChildren()) do
            if obj.Name == "GunDrop" then
                local hl = obj:FindFirstChild("LouisGunHL")
                if not hl then
                    hl = Instance.new("Highlight")
                    hl.Name = "LouisGunHL"
                    hl.Parent = obj
                    hl.FillColor = Color3.fromRGB(0, 0, 255)
                    hl.OutlineColor = Color3.fromRGB(0, 0, 255)
                    hl.FillOpacity = 0.5
                    hl.OutlineOpacity = 1
                end
            end
        end
    end
end)

-- // LOGIC SILENT AIM (PERFECT VECTOR REDIRECTION) //
local oldNamecall
oldNamecall = hookmetamethod(game, "__namecall", function(self, ...)
    local method = getnamecallmethod()
    local args = {...}
    
    if not checkcaller() and method == "FireServer" then
        
        -- Jika pegang Gun (Sheriff) -> Lock Murderer
        if self.Name == "ShootGun" and SilentSheriff then
            for _, v in pairs(Players:GetPlayers()) do
                if v ~= LocalPlayer and v.Character and v.Character:FindFirstChild("HumanoidRootPart") then
                    if IsMurderer(v) then
                        -- Cari argument kordinat tembakan dan ganti ke dada Murderer
                        for i, arg in pairs(args) do
                            if typeof(arg) == "Vector3" then
                                args[i] = v.Character.HumanoidRootPart.Position
                                return oldNamecall(self, unpack(args))
                            end
                        end
                    end
                end
            end
            
        -- Jika pegang Knife (Murderer) -> Lock Selain Murderer
        elseif self.Name == "ThrowKnife" and SilentMurder then
            for _, v in pairs(Players:GetPlayers()) do
                if v ~= LocalPlayer and v.Character and v.Character:FindFirstChild("HumanoidRootPart") then
                    if not IsMurderer(v) then 
                        -- Cari argument kordinat lemparan dan ganti ke dada Target
                        for i, arg in pairs(args) do
                            if typeof(arg) == "Vector3" then
                                args[i] = v.Character.HumanoidRootPart.Position
                                return oldNamecall(self, unpack(args))
                            end
                        end
                    end
                end
            end
        end
        
    end
    return oldNamecall(self, ...)
end)

